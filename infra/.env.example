# Copy to infra/.env and fill in.

# The domain pointing at this server. Caddy obtains a certificate for it.
DOMAIN=desky.example.com

# Address for Let's Encrypt: certificate expiry notices go here.
ACME_EMAIL=you@example.com

# This server's public IP.
#
# An IP, not a domain: coturn tells connecting peers its own address, and
# behind NAT it would otherwise name an unreachable internal one.
PUBLIC_IP=203.0.113.10

# Shared secret for minting short-lived TURN credentials.
#
#   openssl rand -hex 32
#
# The server issues one-time username/password pairs from it. The secret
# itself never reaches a browser.
TURN_SECRET=

# Set to 1 only after you have given coturn a certificate
# (cert= and pkey= in infra/coturn/turnserver.conf).
#
# Without one, coturn will not open its TLS port and a turns: address is
# useless — peers waste time on a candidate that can never complete. That
# is exactly the case a TLS relay exists for: a firewall that lets
# nothing but TLS out.
TURN_TLS=0

# The unprivileged host account every container runs as.
#
# Written by scripts/deploy.sh, which creates the account. Set by hand
# only if you are bringing the stack up without it:
#
#   sudo useradd --system --shell /usr/sbin/nologin desky
#   id -u desky; id -g desky
#
# The volumes must belong to this uid before anything starts, or the
# device registry and the certificate cannot be written.
SERVICE_UID=
SERVICE_GID=
