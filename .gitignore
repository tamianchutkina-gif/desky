node_modules/
dist/
release/
*.log
.DS_Store
.env
.env.*
!.env.example

# turnserver.conf plus the TURN secret, assembled on the server by
# scripts/deploy.sh. The secret lives in a file rather than on coturn's
# command line, where any account on the machine could read it.
infra/coturn/turnserver.local.conf

# Device registry written by a locally running signaling server.
data/

# Copied into the agent by scripts/sync-shared.mjs before every start
# or build. The originals live in shared/ and packages/server/public/.
packages/host/shared/
packages/host/renderer/fonts.css
packages/host/renderer/fonts/
packages/host/src/build-config.json

# The packaged agent published to clients — built on a Mac, not versioned.
downloads/

# Design and review scratch, and the archive made for one review pass.
.impeccable/
Desky-source-for-review.zip

# Written by scripts/sync-shared.mjs from DESKY_SERVER at build time.
# Committing it pins the tree to one deployment.
/build-config.json

# Private operations notes — never published.
.private/

# Local Claude Code permissions — per machine, not per project.
.claude/settings.json
.claude/settings.local.json
